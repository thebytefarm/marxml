{
  "name": "marxml",
  "version": "0.1.1",
  "description": "Fast markdown + XML query and mutation. Rust core with native Node bindings.",
  "keywords": [
    "markdown",
    "xml",
    "parser",
    "ast",
    "napi",
    "rust"
  ],
  "license": "MIT OR Apache-2.0",
  "author": "Zac Rosenbauer <me@zrosenbauer.com>",
  "homepage": "https://github.com/thebytefarm/marxml",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thebytefarm/marxml.git"
  },
  "bugs": {
    "url": "https://github.com/thebytefarm/marxml/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./marxml.d.ts",
      "import": "./marxml.mjs"
    }
  },
  "types": "./marxml.d.ts",
  "files": [
    "marxml.mjs",
    "marxml.d.ts",
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "napi build --platform --release --esm --js-package-name marxml",
    "build:debug": "napi build --platform --esm --js-package-name marxml",
    "test": "vitest run"
  },
  "napi": {
    "binaryName": "marxml",
    "packageName": "marxml",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.6.2",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}